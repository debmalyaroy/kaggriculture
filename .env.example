# Copy to .env and fill in. Nothing in this repo reads .env automatically --
# the Kaggle tools shell out to the `kaggle` CLI, which reads
# %USERPROFILE%\.kaggle\kaggle.json itself. These are here so a fresh machine
# knows what it needs.

# Kaggle API credentials (https://www.kaggle.com/settings -> Create New Token)
KAGGLE_USERNAME=
KAGGLE_KEY=

# Competition slug. Only change this if you are pointing the tools at a fork.
KAGGRICULTURE_COMPETITION=kaggriculture

# Where scratch goes. Defaults to .local/ inside the project; never a home dir.
KAGGRICULTURE_LOCAL=.local

# Parallelism for evaluation and search. Defaults to cpu_count() - 2.
KAGGRICULTURE_WORKERS=
